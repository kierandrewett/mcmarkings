{
  "schemaVersion": 1,
  "id": "mcmarkings",
  "version": "${version}",
  "name": "MCMarkings Companion",
  "description": "Browse folders of images in game, generate new ones from scripts, and place them on walls through the ImageFrame plugin.",
  "authors": [
    "Kieran Drewett"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.kierandrewett.mcmarkings.McMarkingsCompanion"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.1",
    "java": ">=25",
    "fabric-api": "*",
    "owo": ">=0.13.0"
  }
}
